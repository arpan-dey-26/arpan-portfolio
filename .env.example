# ---------------------------------------------------------------------------
# Server-side only. Used exclusively inside /api functions (api/chat.ts) to
# call Anthropic's Messages API. NEVER prefix this with VITE_ — any
# VITE_-prefixed variable is bundled into client-side code and becomes
# publicly visible in the browser. This one must stay server-only.
#
# Get a key at https://console.anthropic.com — set this in Vercel's project
# settings (Environment Variables), not just in a local .env file, or
# api/chat.ts will 503 in production with "Chat is not configured yet."
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Public — safe to expose to the client (this is exactly what EmailJS's
# architecture expects; the public key is rate-limited/domain-restricted on
# EmailJS's own end, not a secret the way ANTHROPIC_API_KEY above is).
# Create a free account at https://www.emailjs.com, add an email service
# (e.g. connect your Gmail), create a template with {{from_name}},
# {{from_email}}, and {{message}} variables, then fill these in from your
# EmailJS dashboard. Without these three set, the contact form will show
# "The contact form is not configured yet."
# ---------------------------------------------------------------------------
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# Public. Safe to expose to the client — used for <meta> tags in index.html
# (via Vite's %VITE_*% HTML interpolation) and by src/config/env.ts.
# VITE_SITE_URL is a placeholder — swap in the real deployed domain once one
# exists (source data listed the portfolio URL as "Pending").
# ---------------------------------------------------------------------------
VITE_SITE_URL=https://example.com
VITE_SITE_TITLE=Arpan Dey — Software Engineer
VITE_SITE_DESCRIPTION=Portfolio of Arpan Dey — Software Engineer, Java Developer, and AI & Full-Stack Developer building intelligent digital solutions.
VITE_OG_IMAGE=/og-image.png
